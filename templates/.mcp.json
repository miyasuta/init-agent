{
    "mcpServers": {
        "cds-mcp": {
            "type": "stdio",
            "command": "npx",
            "args": [
                "-y",
                "@cap-js/mcp-server"
            ],
            "env": {}
        },
        "fiori-mcp": {
            "type": "stdio",
            "command": "npx",
            "args": [
                "--yes",
                "@sap-ux/fiori-mcp-server@latest",
                "fiori-mcp"
            ],
            "env": {}
        }
    }
}
